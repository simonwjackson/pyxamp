}
const spriteIndex = Object.fromEntries(sprites.slice().sort((a, b) => (a.name < b.name ? -1 : 1)).map((s) => [s.name, [s.x, s.y, s.w, s.h]]));
const js = `.pragma library
// GENERATED by face/tools/gen-skin from docs/mock/skin.js and W95FAGrid.ttf. Do not edit.
// Rects are [x, y, w, h] in skin pixels on assets/skin.png.

var sheet = { width: ${SHEET_W}, height: ${sheetH} };
var sprites = ${JSON.stringify(spriteIndex)};
var volFrames = ${VOL_FRAMES};
var plStepsMax = ${PL_STEPS_MAX};

// The skin's colour roles (docs/mock/skin.js C), for the few things drawn as flat rectangles.
var palette = ${JSON.stringify(C)};
// LCD colour sets: following a foreign player is amber, Pyxamp's own state green.
var lcd = ${JSON.stringify({ green: { on: C.green, dim: C.greenDim, mid: C.greenMid }, amber: { on: C.amber, dim: C.amberDim, mid: C.amberMid } })};
var visPeak = ${JSON.stringify(K.VIS[23])};

// Pyx 5x6: one row of ${T5_CHARS.length} cells per colour.
var text5 = { top: ${t5Top}, cell: 5, height: 6, chars: ${JSON.stringify(T5_CHARS)}, colours: ${JSON.stringify(Object.keys(T5_COLOURS))} };

// W95FA Grid at one font pixel per skin pixel: codepoint -> [x, line, cellWidth, advance].
var sys = { top: ${sysTop}, line: ${SYS_LINE}, lines: ${sysLines.length}, colours: ${JSON.stringify(Object.keys(SYS_COLOURS))}, glyphs: ${JSON.stringify(sysIndex)} };
`;
const outPng = png(sheet);
if (process.argv.includes('--check')) {
  const same = fs.existsSync(OUT_PNG) && fs.readFileSync(OUT_PNG).equals(outPng) && fs.existsSync(OUT_JS) && fs.readFileSync(OUT_JS, 'utf8') === js;
  if (!same) { process.stderr.write('gen-skin: face/assets/skin.png or face/lib/sprites.js is stale; run face/tools/gen-skin\n'); process.exit(1); }
  process.stderr.write('gen-skin: up to date\n');
} else {
  fs.mkdirSync(path.dirname(OUT_PNG), { recursive: true }); fs.mkdirSync(path.dirname(OUT_JS), { recursive: true });
  fs.writeFileSync(OUT_PNG, outPng); fs.writeFileSync(OUT_JS, js);
  process.stderr.write(`gen-skin: ${sprites.length} sprites, ${sysGlyphs.length} W95FA glyphs, sheet ${SHEET_W}x${sheetH}\n`);
}
