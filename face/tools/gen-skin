for (const cp of want) { const g = font.cmap.get(cp); if (g === undefined && cp !== 0x20) continue; sysGlyphs.push({ cp, ...rasterGlyph(font, g || 0) }); }
const sysRowW = sysGlyphs.reduce((a, g) => a + g.w, 0);

// ---------- pack ----------
const SHEET_W = 1024;
for (const s of sprites) if (!s.raster) { const r = new Raster(s.w, s.h); s.draw(r.ctx()); s.raster = r; }
const order = sprites.slice().sort((a, b) => b.h - a.h || b.w - a.w || (a.name < b.name ? -1 : 1));
let px = 0, py = 0, rowH = 0;
for (const s of order) {
  if (px + s.w > SHEET_W) { py += rowH + 1; px = 0; rowH = 0; }
  s.x = px; s.y = py; px += s.w + 1; rowH = Math.max(rowH, s.h);
}
py += rowH + 1;
const t5Top = py, t5RowW = T5_CHARS.length * 5;
const t5Rows = Object.keys(T5_COLOURS).length;
const sysTop = t5Top + t5Rows * 6 + 1;
const sysPerLine = Math.ceil(sysRowW / SHEET_W);
const sysLines = splitLines(sysGlyphs, SHEET_W);
const sheetH = sysTop + Object.keys(SYS_COLOURS).length * sysLines.length * SYS_LINE;
if (t5RowW > SHEET_W) throw new Error('5x6 row too wide');
void sysPerLine;
function splitLines(gs, max) { const lines = [[]]; let x = 0; for (const g of gs) { if (x + g.w > max) { lines.push([]); x = 0; } lines[lines.length - 1].push(g); x += g.w; } return lines; }

const sheet = new Raster(SHEET_W, sheetH);
const blit = (r, dx, dy) => { for (let j = 0; j < r.height; j++) for (let i = 0; i < r.width; i++) { const o = (j * r.width + i) * 4; if (!r.data[o + 3]) continue; const d = ((dy + j) * SHEET_W + dx + i) * 4; sheet.data.set(r.data.subarray(o, o + 4), d); } };
for (const s of sprites) blit(s.raster, s.x, s.y);
const sctx = sheet.ctx();
Object.values(T5_COLOURS).forEach((col, row) => { [...T5_CHARS].forEach((ch, i) => K.text5(sctx, ch, i * 5, t5Top + row * 6, col)); });
const sysIndex = {};
Object.entries(SYS_COLOURS).forEach(([, col], ci) => {
  sysLines.forEach((line, li) => {
    let x = 0; const top = sysTop + (ci * sysLines.length + li) * SYS_LINE;
    for (const g of line) {
      sctx.fillStyle = col; for (const [bx, by] of g.bits) sctx.fillRect(x + bx, top + by, 1, 1);
      if (ci === 0) sysIndex[g.cp] = [x, li, g.w, g.adv];
      x += g.w;
    }
