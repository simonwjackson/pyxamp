const EXPORTS = ['C', 'VIS', 'chassisRow', 'mix', 'hex', 'R', 'P', 'frame', 'map', 'text5', 'w5', 'label', 'labelW', 'digit9',
  'bevelBox', 'led', 'GL', 'glyph', 'transportBtn', 'TF', 'tfW', 'titleText', 'titleBar', 'titleBtn', 'markSmall', 'markBig',
  'MARK9', 'MARK13', 'knob', 'tube', 'volCol', 'balCol', 'eqCol', 'lcdBox', 'labelBtn', 'repeatIcon', 'MINI', 'F5', 'FL'];
const K = vm.runInNewContext(skinSrc + `\n;({${EXPORTS.join(',')}})`, {}, { filename: SKIN_JS });
const C = K.C;

class Raster {
  constructor(w, h) { this.width = w; this.height = h; this.data = new Uint8Array(w * h * 4); }
  ctx() {
    const r = this;
    return {
      fillStyle: '#000000',
      fillRect(x, y, w, h) {
        const [cr, cg, cb] = K.hex(this.fillStyle);
        for (let j = Math.max(0, y); j < Math.min(r.height, y + h); j++)
          for (let i = Math.max(0, x); i < Math.min(r.width, x + w); i++) {
            const o = (j * r.width + i) * 4; r.data[o] = cr; r.data[o + 1] = cg; r.data[o + 2] = cb; r.data[o + 3] = 255;
          }
      },
    };
  }
  // Replace exact colours (used for the dimmed knob, which the mock does not draw).
  recolor(pairs) {
    const m = new Map(pairs.map(([a, b]) => [K.hex(a).join(','), K.hex(b)]));
    for (let o = 0; o < this.data.length; o += 4) {
      if (!this.data[o + 3]) continue;
      const to = m.get(`${this.data[o]},${this.data[o + 1]},${this.data[o + 2]}`);
      if (to) { this.data[o] = to[0]; this.data[o + 1] = to[1]; this.data[o + 2] = to[2]; }
    }
    return this;
  }
}

// ---------- W95FA Grid: a small TrueType reader and a centre-sample rasteriser ----------
function readFont(buf) {
  const u16 = (o) => buf.readUInt16BE(o), i16 = (o) => buf.readInt16BE(o), u32 = (o) => buf.readUInt32BE(o);
  const tables = {}; const n = u16(4);
  for (let i = 0; i < n; i++) { const o = 12 + i * 16; tables[buf.toString('latin1', o, o + 4)] = u32(o + 8); }
  const head = tables.head, upm = u16(head + 18), locFmt = i16(head + 50);
  const numGlyphs = u16(tables.maxp + 4), numH = u16(tables.hhea + 34);
  const adv = (g) => u16(tables.hmtx + Math.min(g, numH - 1) * 4);
  const loca = (g) => locFmt ? u32(tables.loca + g * 4) : u16(tables.loca + g * 2) * 2;
  const cmap = new Map(); const ct = tables.cmap, nsub = u16(ct + 2);
  for (let i = 0; i < nsub; i++) {
    const pid = u16(ct + 4 + i * 8), eid = u16(ct + 6 + i * 8), off = ct + u32(ct + 8 + i * 8), fmt = u16(off);
    if (pid !== 3 || eid !== 1 || fmt !== 4) continue;
    const segX2 = u16(off + 6), ends = off + 14, starts = ends + segX2 + 2, deltas = starts + segX2, ranges = deltas + segX2;
    for (let s = 0; s < segX2 / 2; s++) {
      const end = u16(ends + s * 2), start = u16(starts + s * 2), delta = i16(deltas + s * 2), ro = u16(ranges + s * 2);
      for (let c = start; c <= end && c !== 0xffff; c++) {
        let g; if (!ro) g = (c + delta) & 0xffff; else { const gi = u16(ranges + s * 2 + ro + (c - start) * 2); g = gi ? (gi + delta) & 0xffff : 0; }
        if (g) cmap.set(c, g);
      }
    }
  }
  function contours(g) {
    if (g >= numGlyphs) return [];
    const a = loca(g), b = loca(g + 1); if (a === b) return [];
    const o = tables.glyf + a, nc = i16(o);
    if (nc < 0) throw new Error(`composite glyph ${g} is not supported`);
    const endPts = []; for (let i = 0; i < nc; i++) endPts.push(u16(o + 10 + i * 2));
    const np = endPts[nc - 1] + 1; let p = o + 10 + nc * 2; p += 2 + u16(p);
    const flags = []; while (flags.length < np) { const f = buf[p++]; flags.push(f); if (f & 8) { let r = buf[p++]; while (r--) flags.push(f); } }
    const xs = [], ys = []; let v = 0;
    for (const f of flags) { if (f & 2) { const d = buf[p++]; v += (f & 16) ? d : -d; } else if (!(f & 16)) { v += i16(p); p += 2; } xs.push(v); }
    v = 0;
    for (const f of flags) { if (f & 4) { const d = buf[p++]; v += (f & 32) ? d : -d; } else if (!(f & 32)) { v += i16(p); p += 2; } ys.push(v); }
    const out = []; let s = 0;
    for (const e of endPts) { const c = []; for (let i = s; i <= e; i++) c.push([xs[i], ys[i]]); out.push(c); s = e + 1; }
    return out; // off-curve points are kept as polygon vertices: the grid font has straight edges only
  }
  return { upm, cmap, adv, contours };
}
const SYS_PX = 80, SYS_ASC = 10, SYS_LINE = 13; // W95FA Grid: 80 units per pixel, baseline 10 px down, 13 px line
function rasterGlyph(font, g) {
  const cs = font.contours(g), advPx = Math.round(font.adv(g) / SYS_PX);
  let maxX = 0; for (const c of cs) for (const [x] of c) maxX = Math.max(maxX, Math.ceil(x / SYS_PX));
  const w = Math.max(advPx, maxX), bits = [];
  for (let py = 0; py < SYS_LINE; py++) for (let px = 0; px < w; px++) {
    const x = (px + 0.5) * SYS_PX, y = (SYS_ASC - py - 0.5) * SYS_PX; let wind = 0;
    for (const c of cs) for (let i = 0; i < c.length; i++) {
      const [x0, y0] = c[i], [x1, y1] = c[(i + 1) % c.length];
      if (y0 <= y) { if (y1 > y && (x1 - x0) * (y - y0) - (x - x0) * (y1 - y0) > 0) wind++; }
      else if (y1 <= y && (x1 - x0) * (y - y0) - (x - x0) * (y1 - y0) < 0) wind--;
    }
    if (wind) bits.push([px, py]);
  }
  return { w, adv: advPx, bits };
}

