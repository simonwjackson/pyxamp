#!/usr/bin/env -S nix --extra-experimental-features "nix-command flakes" shell nixpkgs#nodejs_24 --command node
// make-fixtures: writes face/fixtures/*.json, the states the replay
// server sends over the real socket protocol for the face's checks.
//
// Each file is { description, state, visualizer: [frames...], visualizerFps, pages? }.
// state and every frame are exactly the wire payloads of the canonical step-1
// schema (contracts/pyxamp.schema.json); the replay server fills in only
// revision and sequence. Step-2 files add `pages`, the answers to
// library.open and search (docs/seam-step2.md).
//
// Usage: face/tools/make-fixtures [--check]
'use strict';
const fs = require('node:fs');
const path = require('node:path');

const OUT = path.resolve(__dirname, '../fixtures');

const allCaps = { play: true, pause: true, stop: true, previous: true, next: true, seek: true, volume: true, repeat: true, shuffle: true };
const firefox = { busName: 'org.mpris.MediaPlayer2.firefox.instance_1_42', owner: ':1.87' };
const mpv = { busName: 'org.mpris.MediaPlayer2.mpv', owner: ':1.112' };
const chromium = { busName: 'org.mpris.MediaPlayer2.chromium.instance9031', owner: ':1.140' };
const podcasts = { busName: 'org.mpris.MediaPlayer2.gpodder', owner: ':1.95' };

// A deterministic spectrum: louder lows, a moving bump. Integers 0..255.
function spectrum(n) {
  const out = [];
  for (let i = 0; i < 75; i++) {
    const x = i / 74, bump = Math.exp(-Math.pow((x - (0.2 + 0.1 * Math.sin(n * 0.7))) * 6, 2));
    const v = 210 * Math.pow(1 - x, 0.8) * (0.55 + 0.25 * Math.sin(n * 1.3 + i * 0.45)) + 70 * bump + 18 * ((i * 7 + n * 3) % 5) / 5;
    out.push(Math.max(0, Math.min(255, Math.round(v))));
  }
  return out;
}
function waveform(n) {
  const out = [];
  for (let i = 0; i < 75; i++) out.push(Math.max(0, Math.min(255, Math.round(128 + 70 * Math.sin(i / 75 * Math.PI * 6 + n * 0.37) + 25 * Math.sin(i / 75 * Math.PI * 17 + n * 0.9)))));
  return out;
}
const zeros = () => Array(75).fill(0), centre = () => Array(75).fill(128);
const ready = (target, frames = 8) => Array.from({ length: frames }, (_, n) => ({ target, sequence: 0, status: 'ready', columns: spectrum(n), waveform: waveform(n) }));
const idle = (target) => [Object.assign(target ? { target } : {}, { sequence: 0, status: 'idle', columns: zeros(), waveform: centre() })];
const unavailable = (target, reason) => [{ target, sequence: 0, status: 'unavailable', columns: zeros(), waveform: centre(), reason }];

const state = (player) => ({ revision: 0, player, library: { _tag: 'noSources' }, queue: [] });
const following = (p) => ({ _tag: 'following', payload: p });

const khruangbin = { title: 'Tiny Desk Concert', artist: 'Khruangbin', id: '/org/mpris/MediaPlayer2/firefox/track/42', durationMs: 1471000 };

const FIXTURES = {
  idle: {
    description: 'No player to follow; own playback idle (step 1 has no sources).',
    state: state({ _tag: 'idle', payload: {} }), visualizer: idle(null),
  },
  'following-playing': {
    description: 'Following a Firefox tab that plays. Firefox offers no repeat or shuffle.',
    state: state(following({ target: firefox, identity: 'Firefox', track: khruangbin, transport: 'playing', capabilities: { ...allCaps, repeat: false, shuffle: false }, positionMs: 254000, volume: 0.8, rate: 1 })),
    visualizer: ready(firefox), visualizerFps: 30,
  },
  'following-paused': {
    description: 'Following Firefox, paused: no signal from its stream.',
    state: state(following({ target: firefox, identity: 'Firefox', track: khruangbin, transport: 'paused', capabilities: { ...allCaps, repeat: false, shuffle: false }, positionMs: 254000, volume: 0.8, rate: 1 })),
    visualizer: idle(firefox),
  },
  'following-stopped': {
    description: 'Following Firefox after it stopped.',
    state: state(following({ target: firefox, identity: 'Firefox', track: khruangbin, transport: 'stopped', capabilities: { ...allCaps, repeat: false, shuffle: false }, volume: 0.8 })),
    visualizer: idle(firefox),
  },
  'following-full': {
    description: 'Following mpv with every capability and full metadata (320 kbps, 44 kHz, stereo, repeat all, shuffle on).',
    state: state(following({
      target: mpv, identity: 'mpv',
      track: { title: "Cybele's Reverie", artist: 'Stereolab', album: 'Emperor Tomato Ketchup', id: '/org/mpris/MediaPlayer2/mpv/track/3', durationMs: 171000, bitrateKbps: 320, sampleRateHz: 44100, channels: 2 },
      transport: 'playing', capabilities: allCaps, positionMs: 83000, volume: 0.72, repeat: 'all', shuffle: true, rate: 1,
    })),
    visualizer: ready(mpv), visualizerFps: 30,
  },
  'following-lossless': {
    description: 'Lossless metadata: 24 bit, 96 kHz. The bit depth takes the kbps box.',
    state: state(following({
      target: mpv, identity: 'mpv',
      track: { title: 'Roygbiv', artist: 'Boards of Canada', album: 'Music Has the Right to Children', id: '/org/mpris/MediaPlayer2/mpv/track/7', durationMs: 151000, bitrateKbps: 2300, sampleRateHz: 96000, bitDepth: 24, channels: 2 },
      transport: 'playing', capabilities: allCaps, positionMs: 12000, volume: 1, repeat: 'one', shuffle: false, rate: 1,
    })),
    visualizer: ready(mpv), visualizerFps: 30,
  },
  'following-limited': {
    description: 'Capability loss: a Chromium stream with no length, no seek, no next/previous, no volume. Capture is ambiguous.',
    state: state(following({
      target: chromium, identity: 'Chromium',
      track: { title: 'Radio Paradise Main Mix', artist: '' },
      transport: 'playing', capabilities: { play: true, pause: true, stop: false, previous: false, next: false, seek: false, volume: false, repeat: false, shuffle: false }, positionMs: 3723000,
    })),
    visualizer: unavailable(chromium, 'two Chromium tabs play audio; cannot tell which one this is'),
  },
  'following-mono-long': {
    description: 'A mono podcast with a long title (marquee scroll), 64 kbps 22 kHz, past 99:59 (hours clock).',
    state: state(following({
      target: podcasts, identity: 'gPodder',
      track: { title: 'Episode 412: The surprisingly long history of the humble cassette tape, and why it came back', artist: 'The Allusionist', id: '/org/gpodder/episode/412', durationMs: 22964000, bitrateKbps: 64, sampleRateHz: 22050, channels: 1 },
      transport: 'playing', capabilities: allCaps, positionMs: 21760000, volume: 0.5, repeat: 'off', shuffle: false, rate: 1.5,
    })),
    visualizer: ready(podcasts), visualizerFps: 30,
  },
  unavailable: {
    description: 'D-Bus failure: the daemon cannot see any player.',
    state: state({ _tag: 'unavailable', payload: { code: 'dbusUnavailable', message: 'the session bus is not reachable' } }), visualizer: idle(null),
  },
};

// ---------- step 2: sources, own playback, pages (docs/seam-step2.md) ----------
const ok = { _tag: 'ready', payload: {} };
const engineReady = { _tag: 'ready', payload: {} };
const local = { id: 'local', name: 'This computer', local: true, active: true };
const sonos = { id: 'sonos-living-room', name: 'Living Room', local: false, active: false };
const pyxisGroups = [
  { id: 'placement:collection', label: 'Albums', kind: 'albums', count: 412 },
  { id: 'signal:hot', label: 'Hot albums', kind: 'albums', count: 18 },
  { id: 'tag:late-night', label: 'Late night', kind: 'albums', count: 23 },
  { id: 'bookmarks', label: 'Bookmarks', kind: 'bookmarks', count: 7 },
  { id: 'stations', label: 'Stations', kind: 'stations', count: 4 },
  { id: 'playlists', label: 'Playlists', kind: 'playlists', count: 3 },
];
const ossicleGroups = [
  { id: 'up-next', label: 'Up next', kind: 'upNext', count: 5 },
  { id: 'shows', label: 'Shows', kind: 'shows', count: 31 },
  { id: 'books', label: 'Books', kind: 'books', count: 9 },
];
const summaries = (jellyfin) => ({ _tag: 'sources', sources: [
  { source: 'pyxis', label: 'Pyxis', status: ok, groups: pyxisGroups },
  { source: 'ossicle', label: 'Ossicle', status: ok, groups: ossicleGroups },
  { source: 'jellyfin', label: 'Jellyfin', status: jellyfin, groups: [] },
] });
const jfDown = { _tag: 'unavailable', payload: { code: 'unreachable', message: 'jellyfin.local did not answer' } };
const pyxTrack = (n, title, album, ms) => ({ source: 'pyxis', id: `track:${album}:${n}`, kind: 'track', title, subtitle: 'Stereolab', album, year: 1997, durationMs: ms, openable: false, playable: true });
const dots = [pyxTrack(1, 'Brakhage', 'Dots and Loops', 270000), pyxTrack(2, 'Miss Modular', 'Dots and Loops', 291000), pyxTrack(3, 'The Flower Called Nowhere', 'Dots and Loops', 304000)];
const etk = [pyxTrack(1, 'Metronomic Underground', 'Emperor Tomato Ketchup', 474000), pyxTrack(2, "Cybele's Reverie", 'Emperor Tomato Ketchup', 171000)];
const queueOf = (items, current, statuses = {}) => items.map((item, i) => ({ occurrence: `occ-${i + 1}`, item, albumKey: `${item.source}:${item.album || item.subtitle}`, status: statuses[i] || (i < current ? 'played' : i === current ? 'current' : 'pending') }));
const pyxisCaps = { play: true, pause: true, stop: true, previous: true, next: true, seek: true, volume: true, repeat: true, shuffle: true };
const ownPlayback = (o) => Object.assign({ source: 'pyxis', output: local, transport: 'playing', capabilities: pyxisCaps, volume: 0.8, repeat: 'off', shuffle: false }, o);
const withSources = (s, extra) => Object.assign({ revision: 0, player: { _tag: 'idle', payload: {} }, library: summaries(jfDown), queue: [], engine: engineReady }, s, extra);
const albumItem = (id, title, artist, year, count) => ({ source: 'pyxis', id, kind: 'album', title, subtitle: artist, year, count, openable: true, playable: true });
const episode = (n, title, show, ms, progress) => Object.assign({ source: 'ossicle', id: `episode:${n}`, kind: 'episode', title, subtitle: show, durationMs: ms, openable: false, playable: true }, progress ? { progress } : {});
const episodes = [
  episode(1, 'The cassette comeback', 'The Allusionist', 1830000, { played: true }),
  episode(2, 'Liner notes', 'The Allusionist', 2140000, { played: false, positionMs: 640000 }),
  episode(3, 'Mixtapes', 'Song Exploder', 1500000),
];

Object.assign(FIXTURES, {
  'library-sources': {
    description: 'Step 2: Pyxis and Ossicle ready, Jellyfin unavailable; nothing active. Pages answer library.open of Albums and a search.',
    state: withSources({ engine: engineReady }), visualizer: idle(null),
    pages: [
      { id: 'fixture-open-albums', source: 'pyxis', node: 'placement:collection', items: [albumItem('album:dots', 'Dots and Loops', 'Stereolab', 1997, 10), albumItem('album:etk', 'Emperor Tomato Ketchup', 'Stereolab', 1996, 13)], nextCursor: 'page-2', total: 412 },
      { id: 'fixture-search', query: 'stereo', items: [albumItem('album:dots', 'Dots and Loops', 'Stereolab', 1997, 10), Object.assign({}, episodes[2], { title: 'Stereolab: Brakhage' })] },
    ],
  },
  'own-pyxis-playing': {
    description: 'Step 2: Pyxamp plays a Pyxis queue here. Two albums for album mode; Sonos is a second output.',
    state: withSources({}, { own: ownPlayback({ track: { title: 'Miss Modular', artist: 'Stereolab', album: 'Dots and Loops', durationMs: 291000, bitrateKbps: 320, sampleRateHz: 44100, channels: 2 }, occurrence: 'occ-2', positionMs: 61000 }), queue: queueOf([...dots, ...etk], 1), outputs: [local, sonos] }),
    visualizer: ready(null), visualizerFps: 30,
  },
  'own-pyxis-console': {
    description: 'Step 2: console mode. Pyxamp drives the Living Room Sonos; no local audio, flat visualizer.',
    state: withSources({}, { own: ownPlayback({ output: Object.assign({}, sonos, { active: true }), track: { title: 'Brakhage', artist: 'Stereolab', album: 'Dots and Loops', durationMs: 270000 }, occurrence: 'occ-1', positionMs: 12000 }), queue: queueOf(dots, 0), outputs: [Object.assign({}, local, { active: false }), Object.assign({}, sonos, { active: true })] }),
    visualizer: idle(null),
  },
  'own-yielded': {
    description: 'Step 2: a Firefox tab started, so own Pyxis playback paused and resumes if Firefox stops in time.',
    state: withSources({ player: following({ target: firefox, identity: 'Firefox', track: khruangbin, transport: 'playing', capabilities: { ...allCaps, repeat: false, shuffle: false }, positionMs: 254000, volume: 0.8, rate: 1 }) }, { own: ownPlayback({ transport: 'paused', track: { title: 'Miss Modular', artist: 'Stereolab', album: 'Dots and Loops', durationMs: 291000 }, occurrence: 'occ-2', positionMs: 61000, yielded: { resumeByMs: 1793000000000 } }), queue: queueOf(dots, 1) }),
    visualizer: ready(firefox), visualizerFps: 30,
  },
  'own-ossicle-conflict': {
    description: 'Step 2: spoken word at 1.5x with skip intervals; a position conflict waits for Enter.',
    state: withSources({}, { own: ownPlayback({ source: 'ossicle', capabilities: { ...pyxisCaps, repeat: false, shuffle: false }, repeat: undefined, shuffle: undefined, track: { title: 'Liner notes', artist: 'The Allusionist', durationMs: 2140000, bitrateKbps: 64, sampleRateHz: 44100, channels: 1 }, occurrence: 'occ-2', positionMs: 640000, speed: 1.5, skip: { backS: 15, forwardS: 30 }, note: 'POSITION CONFLICT' }), queue: queueOf(episodes, 1),
      conflicts: [{ id: 'conflict-1', item: episodes[1], positions: [{ id: 'here', device: 'Myoko', positionMs: 640000, updatedAtMs: 1792990000000 }, { id: 'phone', device: 'Pixel', positionMs: 1210000, updatedAtMs: 1792995000000 }] }] }),
    visualizer: ready(null), visualizerFps: 30,
  },
  'own-retry-failed': {
    description: 'Step 2: one track failed after retries (red), the next is retrying in 10 s.',
    state: withSources({}, { own: ownPlayback({ transport: 'stopped', track: { title: 'The Flower Called Nowhere', artist: 'Stereolab', album: 'Dots and Loops', durationMs: 304000 }, occurrence: 'occ-3', retry: { attempt: 2, nextAtMs: 1793000010000 } }), queue: queueOf(dots, 2, { 1: 'failed', 2: 'retrying' }) }),
    visualizer: idle(null),
  },
});

const check = process.argv.includes('--check');
let stale = 0;
fs.mkdirSync(OUT, { recursive: true });
for (const [name, f] of Object.entries(FIXTURES)) {
  const file = path.join(OUT, name + '.json'), body = JSON.stringify(f, null, 1) + '\n';
  if (check) { if (!fs.existsSync(file) || fs.readFileSync(file, 'utf8') !== body) { stale++; process.stderr.write(`make-fixtures: ${name}.json is stale\n`); } }
  else fs.writeFileSync(file, body);
}
if (check && stale) process.exit(1);
process.stderr.write(`make-fixtures: ${Object.keys(FIXTURES).length} fixtures ${check ? 'checked' : 'written'}\n`);
