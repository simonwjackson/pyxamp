const check = process.argv.includes('--check');
let stale = 0;
fs.mkdirSync(OUT, { recursive: true });
for (const [name, f] of Object.entries(FIXTURES)) {
  const file = path.join(OUT, name + '.json'), body = JSON.stringify(f, null, 1) + '\n';
  if (check) { if (!fs.existsSync(file) || fs.readFileSync(file, 'utf8') !== body) { stale++; process.stderr.write(`make-fixtures: ${name}.json is stale\n`); } }
  else fs.writeFileSync(file, body);
}
if (check && stale) process.exit(1);
process.stderr.write(`make-fixtures: ${Object.keys(FIXTURES).length} fixtures ${check ? 'checked' : 'written'}\n`);
