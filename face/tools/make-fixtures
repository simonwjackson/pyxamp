function spectrum(n) {
  const out = [];
  for (let i = 0; i < 75; i++) {
    const x = i / 74, bump = Math.exp(-Math.pow((x - (0.2 + 0.1 * Math.sin(n * 0.7))) * 6, 2));
    const v = 210 * Math.pow(1 - x, 0.8) * (0.55 + 0.25 * Math.sin(n * 1.3 + i * 0.45)) + 70 * bump + 18 * ((i * 7 + n * 3) % 5) / 5;
    out.push(Math.max(0, Math.min(255, Math.round(v))));
  }
  return out;
}
function waveform(n) {
  const out = [];
  for (let i = 0; i < 75; i++) out.push(Math.max(0, Math.min(255, Math.round(128 + 70 * Math.sin(i / 75 * Math.PI * 6 + n * 0.37) + 25 * Math.sin(i / 75 * Math.PI * 17 + n * 0.9)))));
