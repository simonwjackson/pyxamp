#!/usr/bin/env -S nix --extra-experimental-features "nix-command flakes" shell nixpkgs#coreutils nixpkgs#gnused nixpkgs#gnugrep nixpkgs#procps nixpkgs#nodejs_24 nixpkgs#jq nixpkgs#socat nixpkgs#grim nixpkgs#imagemagick nixpkgs#libxkbcommon --command bash
# verify: the face's checks. Exits nonzero when any check fails.
#   1. unit tests of the pure modules (face/tests/unit)
#   2. drift: generated sprites and fixtures match their generators
#   3. a private headless desktop (face/tests/session.sh) running the real face
#      against the replay server: keyboard and pointer checks, monitor
#      discovery through Hyprland, fit, persistence, daemon loss, capability
#      loss, reduced motion, and screenshots at 1x and 2x.
# Screenshots and filmstrips are kept in $PYXAMP_VERIFY_OUT (default: a new
# /tmp/pyxamp-face-verify-* directory, printed at the end).
# Uses the installed quickshell, Hyprland (>= 0.56) and labwc; set QS,
# HYPRLAND or LABWC to choose others. Never touches the user's session.
set -uo pipefail
FACE=$(cd "$(dirname "$0")/.." && pwd)
OUT=${PYXAMP_VERIFY_OUT:-$(mktemp -d /tmp/pyxamp-face-verify-XXXXXX)}
mkdir -p "$OUT"
FAILS=0; PASSES=0
pass() { PASSES=$((PASSES + 1)); echo "ok   $1"; }
fail() { FAILS=$((FAILS + 1)); echo "FAIL $1${2:+: $2}"; }
check() { local name=$1; shift; if "$@"; then pass "$name"; else fail "$name"; fi; }
eq() { [ "$1" = "$2" ] || { echo "     expected '$2', got '$1'" >&2; return 1; }; }

echo "== unit tests"
if node --test "$FACE"/tests/unit/*.test.js > "$OUT/unit.txt" 2>&1; then pass "unit tests ($(grep -c '^✔' "$OUT/unit.txt") passed)"; else fail "unit tests" "see $OUT/unit.txt"; fi
echo "== drift"
check "sprites are generated from docs/mock/skin.js" "$FACE/tools/gen-skin" --check
check "fixtures are generated by make-fixtures" "$FACE/tools/make-fixtures" --check

echo "== headless session"
# shellcheck source=../tests/session.sh
. "$FACE/tests/session.sh"
trap 'session_down; if [ -n "${T:-}" ]; then cp -r "$T/logs" "$OUT/logs" 2>/dev/null; rm -rf "$T"; fi' EXIT
session_up || { fail "headless session starts"; exit 1; }
pass "headless session starts ($MON1 1920x1080@1, $MON2 2880x1800@2)"

commands() { ctl '{"commands":true}' | jq -c '[.commands[].command | {tag: .action._tag, payload: .action.payload, bus: .target.busName, owner: .target.owner}]'; }
clear_commands() { ctl '{"clear":true}' >/dev/null; }
last_command() { commands | jq -c '.[-1] // empty'; }
load() { ctl "{\"load\":\"$1\"}" >/dev/null; sleep 0.6; }
geometry() { layer_geometry; }
# pixel X Y in a shot -> "#rrggbb"
pixel() { magick "$T/shots/$1.png" -format "%[hex:p{$2,$3}]" info: | cut -c1-6 | tr 'A-F' 'a-f' | sed 's/^/#/'; }
crop() { # crop SHOT W H X Y OUTNAME: keep a crop in $OUT
  magick "$T/shots/$1.png" -crop "$2x$3+$4+$5" +repage "$OUT/$6.png"
}
surface_crop() { # surface_crop SHOT OUTNAME [EXTRA_W EXTRA_H]: the surface (plus room for popups) in physical px
  local g k s mx lx ly lw lh
  g=$(describe); k=$(echo "$g" | jq -r .k); s=$(monitor_scale "$(echo "$g" | jq -r .screen)"); mx=$(monitor_x "$(echo "$g" | jq -r .screen)")
  read -r lx ly lw lh <<< "$(layer_geometry)"
  crop "$1" "$(echo "$g" | jq -r ".physW + ${3:-0}")" "$(echo "$g" | jq -r ".physH + ${4:-0}")" "$(jq -n "($lx - $mx) * $s | floor")" "$(jq -n "$ly * $s | floor")" "$2"
}

# Start on the first monitor: the pointer there focuses it.
focus_monitor "$MON1"
face_start || { fail "the face starts"; exit 1; }
pass "the face starts (qs -c pyxamp)"

echo "== monitor discovery and size"
check "starts on the focused monitor ($MON1)" eq "$(field screen)" "$MON1"
check "1x: k = 1, surface 275x435" eq "$(geometry)" "16 16 275 435"
check "on top: layer level top" eq "$(layer_level)" "$MON1 2"

echo "== idle"
check "idle: green LCD" eq "$(field lcd)" "green"
check "idle: says nothing to follow and no sources" eq "$(field marquee)" "PYXAMP  ***  NO PLAYER TO FOLLOW. NO SOURCES YET"
shot idle-1x "$MON1"; surface_crop idle-1x idle-1x
check "idle: no command possible" eq "$(clear_commands; click_sp 150 110; kb key x; kb key b; commands)" "[]"

echo "== following, keyboard"
load following-full
check "following: amber LCD" eq "$(field lcd)" "amber"
shot full-1x "$MON1"; surface_crop full-1x following-1x
check "following: clock digit drawn amber at 1x" eq "$(pixel full-1x $((16 + 48 + 1)) $((16 + 26)))" "#ffb020"
clear_commands; click_sp 150 110
kb key x; kb key c; kb key z; kb key b; kb key v
check "X C Z B V send play, pause, previous, next, stop to mpv" eq "$(commands | jq -c '[.[].tag]')" '["transport.play","transport.pause","transport.previous","transport.next","transport.stop"]'
check "commands carry the followed target" eq "$(commands | jq -c '[.[] | .bus + " " + .owner] | unique')" '["org.mpris.MediaPlayer2.mpv :1.112"]'
clear_commands; kb key r; kb key s; kb key up; kb key right
check "R cycles repeat all -> one" eq "$(commands | jq -c '.[0].payload')" '{"mode":"one"}'
check "S turns shuffle off (it is on)" eq "$(commands | jq -c '.[1].payload')" '{"enabled":false}'
check "Up sets the player's volume +2%" eq "$(commands | jq -c '.[2] | [.tag, .payload.value]')" '["volume.set",0.74]'
check "Right seeks +5 s with the track id" eq "$(commands | jq -c '.[3] | [.tag, .payload.trackId, (.payload.positionMs > 85000 and .payload.positionMs < 100000)]')" '["transport.seek","/org/mpris/MediaPlayer2/mpv/track/3",true]'

echo "== following, pointer"
clear_commands
click_sp 50 97; click_sp 119 97
check "click Play and Next" eq "$(commands | jq -c '[.[].tag]')" '["transport.play","transport.next"]'
clear_commands; click_sp 187 96
check "click Shuffle" eq "$(commands | jq -c '[.[].tag]')" '["shuffle.set"]'

echo "== capability loss"
load following-limited
clear_commands; click_sp 150 110; kb key b; kb key z; kb key right; kb key up
click_sp 119 97
check "unsupported next, previous, seek, volume send nothing" eq "$(commands)" "[]"
kb key b; sleep 0.2
check "the display says why" eq "$(field marquee)" "NEXT: Chromium does not offer this"
kb key c
check "supported pause still goes" eq "$(commands | jq -c '[.[].tag]')" '["transport.pause"]'
check "ambiguous capture shows NO CAPTURE, not bars" eq "$(field visual)" "label"
shot limited-1x "$MON1"; surface_crop limited-1x capability-loss-1x
at_sp 118 96; sleep 0.1; at_sp 119 97; sleep 1; shot limited-tip "$MON1"; surface_crop limited-tip capability-loss-tooltip-1x 200 0
check "dimmed Next button drawn with the dim glyph" eq "$(pixel limited-1x $((16 + 116)) $((16 + 96)))" "#8d95aa"

echo "== rejected command"
load following-full
ctl '{"result":{"_tag":"rejected","code":"staleTarget","message":"the player changed"}}' >/dev/null
click_sp 150 110; kb key x; sleep 0.3
check "a refusal shows in the display" eq "$(field marquee)" "PLAY REFUSED: the player changed"
ctl '{"result":{"_tag":"accepted"}}' >/dev/null

echo "== playlist section: no sources"
clear_commands; kb key j; kb type xzcvb
check "J opens the jump box; letters go into it" eq "$(describe | jq -c '[.view, .jump]')" '["jump","xzcvb"]'
check "typed letters never reach transport" eq "$(commands | jq -c '[.[].tag] | map(select(. != "transport.play"))')" "[]"
shot jump-1x "$MON1"; surface_crop jump-1x jump-box-1x
kb key escape
kb key l
check "L opens the library view" eq "$(field view)" "library"
shot lib-1x "$MON1"; surface_crop lib-1x library-no-sources-1x
kb key escape
check "Esc goes back to the queue" eq "$(field view)" "queue"
kb chord alt+3
check "Alt+3 opens item info" eq "$(field view)" "info"
shot info-1x "$MON1"; surface_crop info-1x item-info-1x
kb key escape
click_sp 147 97
check "eject opens the library" eq "$(field view)" "library"
kb key escape

echo "== folds, windowshade, double size"
kb chord alt+g
check "Alt+G folds the EQ at once" eq "$(geometry)" "16 16 275 319"
kb chord alt+e
check "Alt+E folds the playlist" eq "$(geometry)" "16 16 275 116"
kb chord alt+w
check "Alt+W windowshade" eq "$(geometry)" "16 16 275 14"
shot shade-1x "$MON1"; surface_crop shade-1x windowshade-1x
kb chord alt+w; kb chord alt+g; kb chord alt+e
check "unfold all" eq "$(geometry)" "16 16 275 435"
kb chord ctrl+d
check "Ctrl+D doubles: k = 2 on a scale-1 monitor" eq "$(describe | jq -c '[.k, .physW, .physH]')" "[2,550,870]"
check "Ctrl+D surface size" eq "$(geometry)" "16 16 550 870"
shot dbl-1x "$MON1"; surface_crop dbl-1x following-ctrl-d-on-1x-monitor
kb chord ctrl+d
check "Ctrl+D again: back to k = 1" eq "$(geometry)" "16 16 275 435"

echo "== menus"
click_sp 10 8
check "the mark opens the main menu" eq "$(field menu)" "main"
shot menu-1x "$MON1"; surface_crop menu-1x main-menu-1x 120 0
kb key escape
check "Esc closes the menu" eq "$(field menu)" ""
clear_commands; click_sp 10 8; at_sp 40 68; sleep 0.4; at_sp 200 70; sleep 0.2
check "the menu opens again after Esc" eq "$(field menu)" "main"
sleep 0.5; shot submenu-1x "$MON1"; surface_crop submenu-1x repeat-submenu-1x 120 0
click_sp 220 102
check "O menu > Repeat > One track (pointer, submenu)" eq "$(commands | jq -c ".[0] | [.tag, .payload.mode]")" '["repeat.set","one"]'
check "a picked item closes the menu" eq "$(field menu)" ""
click_sp 113 414
check "MISC opens upwards" eq "$(field menu)" "misc"
shot misc-1x "$MON1"; surface_crop misc-1x misc-menu-1x 40 0
kb key escape

echo "== layer: A"
click_sp 14 33
check "A puts Pyxamp on the desktop (layer bottom)" eq "$(layer_level)" "$MON1 1"
click_sp 14 33
check "A again: on top" eq "$(layer_level)" "$MON1 2"

echo "== SUPER+Z on the focused monitor, per-monitor position"
ipc toggle; sleep 0.3
check "toggle hides at once" eq "$(geometry)" ""
focus_monitor "$MON2"
"$QS" -c pyxamp ipc call pyxamp toggle; sleep 0.6
check "qs -c pyxamp ipc call pyxamp toggle shows it on the focused monitor" eq "$(field screen)" "$MON2"
check "2x: k = 2 at scale 2, 275x435 logical" eq "$(describe | jq -c '[.k, .physW, .physH, .logicalW, .logicalH]')" "[2,550,870,275,435]"
check "2x: surface place" eq "$(geometry)" "1936 16 275 435"
shot full-2x "$MON2"; surface_crop full-2x following-2x
check "following: clock digit drawn amber at 2x" eq "$(pixel full-2x $(((16 + 48 + 1) * 2)) $(((16 + 26) * 2)))" "#ffb020"
# Drag the title bar by 120 x 60 logical px. The virtual pointer reaches Qt one
# event late (no wl_pointer.frame after it), so allow some lag at the end.
at_sp 150 8; ptr down
for i in 1 2 3 4 5 6; do ptr "move $((1936 + 150 + i * 20)) $((16 + 8 + i * 10))"; sleep 0.05; done
ptr "move $((1936 + 270)) $((16 + 68))"; sleep 0.2; ptr up; sleep 0.5
read -r gx gy _ _ <<< "$(geometry)"
check "dragging the title bar moves the column (to $gx,$gy)" test "$gx" -ge 2016 -a "$gy" -ge 56
moved="$gx $gy"
ipc toggle; sleep 0.3; focus_monitor "$MON1"; ipc toggle; sleep 0.6
check "on $MON1 it comes back where it was there" eq "$(describe | jq -r '.screen + " " + (.x|tostring) + " " + (.y|tostring)')" "$MON1 16 16"
ipc toggle; sleep 0.3; focus_monitor "$MON2"; ipc toggle; sleep 0.6
check "on $MON2 it comes back where it was moved to" eq "$(geometry | cut -d' ' -f1,2)" "$moved"

echo "== pixel-exact scale"
load following-paused
click_sp 150 110
# Reduced motion stops the marquee, so two scales show the same frame.
click_sp 10 8; click_sp 56 265
check "O menu > Reduced motion" eq "$(field reducedMotion)" "true"
check "reduced motion: vis area says VIS OFF" eq "$(field visual)" "label"
shot still-2x "$MON2"; surface_crop still-2x paused-reduced-motion-2x
ipc toggle; sleep 0.3; focus_monitor "$MON1"; ipc toggle; sleep 0.6
shot still-1x "$MON1"; surface_crop still-1x paused-reduced-motion-1x
magick "$OUT/paused-reduced-motion-2x.png" -sample 50% "$T/down.png"
diffpx=$(magick compare -metric AE "$T/down.png" "$OUT/paused-reduced-motion-1x.png" null: 2>&1 | cut -d' ' -f1)
check "the 2x surface is the 1x surface scaled by exactly 2, nearest neighbour ($diffpx px differ)" eq "$diffpx" "0"
magick "$T/down.png" -sample 200% "$T/up.png"
blocks=$(magick compare -metric AE "$T/up.png" "$OUT/paused-reduced-motion-2x.png" null: 2>&1 | cut -d' ' -f1)
check "every skin pixel is a whole 2x2 block at 2x ($blocks px differ)" eq "$blocks" "0"

echo "== fractional scale 1.5"
hc eval "hl.monitor({ output = \"$MON2\", mode = \"2880x1800@60\", position = \"1920x0\", scale = \"1.5\" })" >/dev/null; sleep 1
ipc toggle; sleep 0.3; focus_monitor "$MON2"; ipc toggle; sleep 0.8
check "scale 1.5 rounds to k = 2: 550x870 physical, 367x580 logical" eq "$(describe | jq -c '[.screen, .k, .physW, .physH, .logicalW, .logicalH]')" "[\"$MON2\",2,550,870,367,580]"
shot still-15 "$MON2"
# A logical place can land on a half physical pixel at 1.5: try both roundings.
read -r lx ly _ _ <<< "$(layer_geometry)"; diff15=999999
for cx in $(jq -n "(($lx - 1920) * 1.5) | floor, (($lx - 1920) * 1.5) | ceil" | sort -u); do for cy in $(jq -n "($ly * 1.5) | floor, ($ly * 1.5) | ceil" | sort -u); do
  magick "$T/shots/still-15.png" -crop "550x870+$cx+$cy" +repage "$T/c15.png"
  magick "$T/c15.png" -sample 50% "$T/down15.png"
  d=$(magick compare -metric AE "$T/down15.png" "$OUT/paused-reduced-motion-1x.png" null: 2>&1 | cut -d' ' -f1)
  [ "$d" -lt "$diff15" ] && { diff15=$d; cp "$T/c15.png" "$OUT/paused-reduced-motion-scale-1.5.png"; }
done; done
check "at scale 1.5 the surface is still the 1x surface scaled by exactly 2 ($diff15 px differ)" eq "$diff15" "0"
hc eval "hl.monitor({ output = \"$MON2\", mode = \"2880x1800@60\", position = \"1920x0\", scale = \"2\" })" >/dev/null; sleep 1
ipc toggle; sleep 0.3; focus_monitor "$MON1"; ipc toggle; sleep 0.8

echo "== motion"
filmstrip() { # filmstrip NAME FRAMES: grab the marquee and the vis every 100 ms
  local g k i; g=$(describe); k=$(echo "$g" | jq -r .k)
  read -r lx ly _ _ <<< "$(layer_geometry)"
  for i in $(seq -w 1 "$2"); do grim -g "$lx,$((ly + 20)) 260x44" "$T/f-$1-$i.png"; sleep 0.1; done
  magick "$T"/f-"$1"-*.png -background '#202028' -splice 0x2 -append "$OUT/filmstrip-$1.png"
  local first last; first=$(ls "$T"/f-"$1"-*.png | head -1); last=$(ls "$T"/f-"$1"-*.png | tail -1)
  magick compare -metric AE "$first" "$last" null: 2>&1 | cut -d' ' -f1
}
moved_rm=$(filmstrip reduced-motion 8)
check "reduced motion: marquee and vis stay still (filmstrip)" eq "$moved_rm" "0"
click_sp 10 8; click_sp 56 265
check "reduced motion off" eq "$(field reducedMotion)" "false"
load following-mono-long
moved_on=$(filmstrip marquee-and-spectrum 12)
check "marquee scrolls and the spectrum moves ($moved_on px changed)" test "$moved_on" -gt 0
click_sp 150 110; kb chord alt+g
read -r fx fy _ _ <<< "$(geometry)"
for i in 1 2 3; do grim -g "$fx,$fy 275x435" "$T/fold-$i.png"; sleep 0.05; done
magick "$T"/fold-*.png -append "$OUT/filmstrip-eq-fold.png"
check "Alt+G folds within one key press: height 319 at once" eq "$(geometry | cut -d" " -f4)" "319"
check "no in-between frame after the fold (sections below the main one)" eq "$(magick compare -metric AE "$T/fold-1.png[275x200+0+116]" "$T/fold-3.png[275x200+0+116]" null: 2>&1 | cut -d" " -f1)" "0"
kb chord alt+g

echo "== short screens"
click_sp 150 110
hc eval "hl.monitor({ output = \"$MON1\", mode = \"1280x720@60\", position = \"0x0\", scale = \"1\" })" >/dev/null; sleep 1
kb chord ctrl+d; sleep 0.3
check "720 px tall: Ctrl+D is refused" eq "$(describe | jq -c '[.k, .dbl, .refused]')" "[1,false,true]"
check "and the display says why" eq "$(field marquee)" "DOUBLE SIZE DOES NOT FIT THIS SCREEN"
hc eval "hl.monitor({ output = \"$MON1\", mode = \"1280x420@60\", position = \"0x0\", scale = \"1\" })" >/dev/null; sleep 1
check "420 px tall: the playlist shrinks first (3 steps to 1)" eq "$(describe | jq -c '[.k, .plN, .physH]')" "[1,1,377]"
shot short "$MON1"; surface_crop short short-screen-1x
hc eval "hl.monitor({ output = \"$MON1\", mode = \"1920x1080@60\", position = \"0x0\", scale = \"1\" })" >/dev/null; sleep 1

echo "== daemon loss"
load following-full
ctl '{"drop":true}' >/dev/null; sleep 0.8
check "daemon loss: DAEMON DISCONNECTED" eq "$(field marquee)" "DAEMON DISCONNECTED"
check "daemon loss: status light red" eq "$(field status)" "error"
shot lost-1x "$MON1"; surface_crop lost-1x daemon-disconnected-1x
check "daemon loss: red status light pixel" eq "$(pixel lost-1x $((16 + 23)) $((16 + 30)))" "#ff3a24"
clear_commands; click_sp 150 110; kb key x; click_sp 50 97
ctl '{"listen":true,"newInstance":true}' >/dev/null; sleep 4
check "reconnects to a new instance for a fresh snapshot" eq "$(describe | jq -c '[.link, .lcd]')" '["connected","amber"]'
check "no command was sent or replayed" eq "$(commands)" "[]"

echo "== unavailable players"
load unavailable
check "unavailable: says so, red light" eq "$(describe | jq -c '[.status, .marquee]')" '["error","PLAYERS UNAVAILABLE: the session bus is not reachable"]'
shot unavailable-1x "$MON1"; surface_crop unavailable-1x players-unavailable-1x

echo "== restart keeps preferences"
click_sp 150 110
kb chord ctrl+d; kb chord alt+g
before=$(describe | jq -c '{screen, dbl, eqOpen, x, y}')
sleep 0.6   # preferences are saved 300 ms after the last change
face_stop; face_start
check "after a restart: same monitor, size, folds and place" eq "$(describe | jq -c '{screen, dbl, eqOpen, x, y}')" "$before"
kb chord ctrl+d; kb chord alt+g

echo
echo "screenshots: $OUT"
echo "$PASSES passed, $FAILS failed"
[ "$FAILS" -eq 0 ]
