#!/usr/bin/env -S nix --extra-experimental-features "nix-command flakes" shell nixpkgs#coreutils nixpkgs#gnused nixpkgs#gnugrep nixpkgs#procps nixpkgs#nodejs_24 nixpkgs#jq nixpkgs#socat nixpkgs#grim nixpkgs#imagemagick nixpkgs#libxkbcommon --command bash
# platinum-boards: screenshots of the Platinum face's states, by the approved
# mock's groups 1-8 (/tmp/macamp-mock/states.js), in each appearance (light,
# dark grey, extra dark), at k = 2 on a scale-2 headless monitor, from the
# replay fixtures. Also the Winamp face in one state, and a live theme swap.
# Shots only; the checks are face/tools/verify-platinum.
#   PYXAMP_BOARDS_OUT   where the shots go (default: a new /tmp/pyxamp-boards-*)
#   PYXAMP_BOARDS_LOOKS which appearances (default: "light grey black")
set -uo pipefail
FACE=$(cd "$(dirname "$0")/.." && pwd)
OUT=${PYXAMP_BOARDS_OUT:-$(mktemp -d /tmp/pyxamp-boards-XXXXXX)}
LOOKS=${PYXAMP_BOARDS_LOOKS:-light grey black}
mkdir -p "$OUT"
. "$FACE/tests/session.sh"
. "$FACE/tests/helpers.sh"
. "$FACE/tests/faces.sh"
check() { "$@" || echo "note: $*" >&2; }
T0=1793000000000
trap 'drm_proof "$OUT/drm-proof.txt"; session_down; if [ -n "${T:-}" ]; then cp -r "$T/logs" "$OUT/logs" 2>/dev/null; rm -rf "$T"; fi; echo "boards: $OUT"' EXIT
session_up || exit 1
desktop_theme platinum light off
use_face platinum
focus_monitor "$MON2"
face_start || exit 1
: > "$OUT/states.tsv"

# The Platinum face's targets at k = 2 are the same sp (click_sp scales them).
look() { case $1 in light) desktop_theme platinum light off ;; grey) desktop_theme platinum dark off ;; black) desktop_theme platinum dark on ;; esac; sleep 2.6; }
# board GROUP ID LABEL [EXTRA_W EXTRA_H]: one cell: the surface (and room for a menu or balloon).
board() {
  local g=$1 id=$2 label=$3 name="g$1-$2-$LOOK"
  shot "b-$name" "$MON2"; surface_crop "b-$name" "$name" "${4:-0}" "${5:-0}"
  describe > "$OUT/$name.json"
  [ "$LOOK" = light ] && printf '%s\t%s\t%s\n' "$g" "$id" "$label" >> "$OUT/states.tsv"
}
fresh() { # a known starting point: everything open, queue view, no menu
  kb key escape; kb key escape
  describe | jq -e '.shade' >/dev/null && kb chord alt+w
  describe | jq -e '.eqOpen | not' >/dev/null && kb chord alt+g
  describe | jq -e '.plOpen | not' >/dev/null && kb chord alt+e
  [ "$(field view)" = queue ] || kb key escape
  sleep 0.2
}
hover() { at_sp "$1" "$2"; sleep 0.1; at_sp "$(($1 + 1))" "$2"; sleep 1.3; }

pass_for() {
  LOOK=$1; look "$LOOK"
  click_pt focus

  # 1. Music from Pyxis, as host
  load own-pyxis-playing; fresh; sleep 0.4
  board 1 playing "Playing: elapsed time, spectrum, 320 kbps 44 kHz stereo"
  kb chord ctrl+t; sleep 0.3; board 1 remaining "Time remaining (Ctrl+T or a click on the clock)"; kb chord ctrl+t
  click_sp 30 60; sleep 0.4; board 1 osc "Oscilloscope (a click on the visualizer)"
  click_sp 30 60; sleep 0.4; board 1 visoff "Visualizer off"
  click_sp 30 60; sleep 0.2
  kb key r; sleep 0.2; board 1 repflash "R: the LCD confirms in sentence case (the replay keeps the mode)"
  sleep 1.2
  kb chord alt+w; sleep 0.3; board 1 shade "Windowshade: the title bar holds a mini LCD and the mini transport"; kb chord alt+w
  board 1 full "The whole window: main, EQ, playlist"
  load own-pyxis-long; sleep 0.2; ctl '{"rebaseWall":0}' >/dev/null; sleep 0.3
  board 1 long-0 "A long title at its start (holds 1.5 s, then 24 sp/s)"
  sleep 4; board 1 long-1 "The same title 4 s later"

  # 2. Pyxis as console
  load own-pyxis-console; fresh; sleep 0.4
  board 2 playing "Console: plays on the Living Room Sonos; flat visualizer; the device on line 3"
  click_pt menu; hover 47 53; kb key right; sleep 0.4
  board 2 menu "O menu > Play on (the desktop's Platinum menu, at the monitor's scale)" 360 120
  kb key escape; kb key escape; sleep 0.2
  board 2 full "Console, whole window: the EQ says it has no effect on the Sonos"

  # 3. Spoken word from Ossicle
  load own-ossicle-playing; fresh; sleep 0.4
  board 3 podcast "Podcast: speed replaces balance, skip buttons, shuffle and repeat dimmed"
  kb key z; sleep 0.2; board 3 back "Z or Back: -15 s"
  sleep 1.3; kb key b; sleep 0.2; board 3 fwd "B or Forward: +30 s"
  sleep 1.3
  board 3 full "Up next: played items ticked and dimmed, a part-played book shows time left"
  click_sp 120 "$(row_y 2)" rclick; sleep 0.5
  board 3 rowmenu "Right-click an episode: Mark as played" 200 60
  kb key escape; sleep 0.2
  click_pt misc; sleep 0.5; board 3 misc "Misc pop-up: Mark as played" 140 0
  kb key escape; sleep 0.2
  kb key i; sleep 0.3; board 3 info "Item info inside the playlist section"; kb key escape

  # 4. Jellyfin (video hand-off rows)
  load library-mixed; fresh; sleep 0.3
  kb key l; kb key up; kb key up; kb key down; kb key down; kb key enter; sleep 0.2
  for _ in 1 2 3; do kb key down; done; kb key enter; sleep 0.6
  board 4 videos "Library: Jellyfin > Videos, outline view; each row opens in mpv"
  y=$(row_y 0); hover 120 "$y"; board 4 videos-tip "Balloon Help on a video row" 120 40
  kb key escape; kb key escape; kb key escape; sleep 0.2

  # 5. Followed foreign player
  load following-playing; fresh; sleep 0.5
  board 5 follow "Following Firefox: amber LCD, its name on line 3"
  load_at own-yielded $((T0 - 86000)); sleep 0.4
  board 5 yielded "Pyxamp yielded: the title states the resume rule"
  sleep 7; board 5 yielded-scroll "The title scrolls on to the resume rule"
  load own-yield-stays; sleep 0.4; sleep 7; board 5 stays "After a long interruption: Pyxamp stays paused"
  kb chord alt+w; sleep 0.3; board 5 shade "Following, in windowshade: the mini LCD is amber too"; kb chord alt+w
  kb chord alt+e; sleep 0.3; board 5 eq "Following: the EQ says it has no effect on Firefox"; kb chord alt+e
  load_at own-yielded $((T0 - 86000)); sleep 0.4; load own-resumed; sleep 0.4
  board 5 back "Hand-back: green again, Back to Pyxamp: resuming"
  sleep 2.2; board 5 back-after "Hand-back: Pyxamp plays on"

  # 6. Playlist section
  load library-mixed; fresh; sleep 0.3
  click_sp 120 "$(row_y 4)"; sleep 0.2
  board 6 queue "Queue (Pyxis): speaker on the current item, the selection in highlight"
  kb key l; kb key up; kb key up; sleep 0.3; board 6 lib-root "Library, root: the sources"
  kb key enter; sleep 0.4; board 6 lib-pyxis "Pyxis: its groups as it reports them"
  kb key down; kb key enter; sleep 1; board 6 lib-albums "Pyxis > Collection: every open level stays visible"
  kb key enter; sleep 0.6; board 6 lib-album "Pyxis > Collection > Dots and Loops"
  kb key escape; kb key escape; kb key escape; kb key escape; sleep 0.2
  kb key j; sleep 0.3; board 6 jump-open "J: the jump box (Find field, focus ring)"
  kb type stereo; sleep 0.8; board 6 jump "Jump: results from three sources, with a Where column"
  for _ in 1 2 3; do kb key down; done; sleep 0.2; board 6 jump-cross "A result from another source: the hint says which pauses"
  kb key escape; kb key j; kb type zzq; sleep 0.8; board 6 jump-none "Jump: nothing found"; kb key escape
  kb key i; sleep 0.3; board 6 info "Item info"; kb key escape
  click_sp 25 497; sleep 0.5; board 6 add "Add pop-up" 120 0; kb key escape
  kb key g; sleep 0.3; board 6 album "Album mode (G): one row per album"; kb key g

  # 7. EQ section
  load own-pyxis-playing; fresh; sleep 0.3
  board 7 default "EQ on, flat"
  click_sp 69 $((150 + 41 + 3 + 15)); sleep 0.1; click_sp 92 $((150 + 41 + 3 + 45)); sleep 0.1; click_sp 161 $((150 + 41 + 3 + 5)); sleep 0.4
  board 7 drag "A user curve; the LCD shows the last value"
  click_sp 25 177; sleep 0.3; board 7 off "EQ off: the curve and sliders dim"; click_sp 25 177
  click_pt presets; sleep 0.5; board 7 presets "Presets pop-up" 160 120; kb key escape
  click_pt presets; sleep 0.4; kb key down; kb key enter; sleep 0.3
  load own-ossicle-playing; sleep 0.3; click_sp 70 177; sleep 0.4; board 7 auto "Auto with spoken word: the Voice preset"; click_sp 70 177
  load own-pyxis-console; sleep 0.4; board 7 console "Console: the EQ has no effect on the Sonos"

  # 8. Edge states
  load library-sources; fresh; kb key l; sleep 0.3; board 8 unreach-lib "Jellyfin unreachable: the library root says so"; kb key escape
  kb key j; kb type broadcast; sleep 0.8; board 8 unreach-jump "Jump box with Jellyfin unreachable"; kb key escape
  load own-engine-unavailable; sleep 0.4; board 8 engine "Playback unavailable: in the title, the error ink"
  load idle; sleep 0.4; board 8 empty "Nothing to follow, no sources"
  load own-pyxis-long; sleep 0.5; board 8 long "A queue of 240 items, scrolled to the current one"
  load_at own-retry-first "$T0"; sleep 0.3; board 8 retry "A track that cannot play: retry 1 in 2 s"
  load_at own-retry-failed $((T0 - 2000)); sleep 2.4; board 8 failed "Given up: the row says cannot play; the next one retries"
  load unavailable; sleep 0.4; board 8 players "Players unavailable"
  load following-full; sleep 0.3; ctl '{"drop":true}' >/dev/null; sleep 0.8; board 8 daemon "Daemon disconnected"
  ctl '{"listen":true,"newInstance":true}' >/dev/null; sleep 3
}

for L in $LOOKS; do pass_for "$L"; done
desktop_theme platinum light off; sleep 0.4

# The Winamp face, one state, to show it is unchanged.
load own-pyxis-playing; fresh
desktop_theme win98 light off; sleep 2.6
LOOK=light; shot b-winamp "$MON2"; surface_crop b-winamp winamp-own-pyxis-playing; describe > "$OUT/winamp-own-pyxis-playing.json"
desktop_theme platinum light off; sleep 2.6
