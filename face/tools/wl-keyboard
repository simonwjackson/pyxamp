#!/usr/bin/env -S nix --extra-experimental-features "nix-command flakes" shell nixpkgs#rust-script nixpkgs#cargo nixpkgs#rustc nixpkgs#gcc --command rust-script
//! wl-keyboard: one virtual keyboard (zwp_virtual_keyboard_v1) kept alive for a
//! test session, driven through a Unix socket. A one-shot tool such as wtype
//! removes its device at once, and the key reaches no one. For the face's
//! headless checks only. Linux x86_64/aarch64 (64-bit msghdr layout).
//!
//! Usage: wl-keyboard --control PATH --keymap FILE
//!   (WAYLAND_DISPLAY and XDG_RUNTIME_DIR name the compositor; FILE is an xkb
//!   keymap, e.g. from `xkbcli compile-keymap --layout us`)
//! Control lines, each answered "ok" or "error: ...":
//!   key NAME          press and release: a-z, 0-9, escape, backspace, enter, delete,
//!                     tab, space, left, right, up, down, insert
//!   chord MOD+..+NAME ctrl, alt, shift, e.g. "chord ctrl+d", "chord alt+3"
//!   type TEXT         each character of TEXT (a-z, 0-9, space)

use std::collections::HashMap;
use std::io::{BufRead, BufReader, Read, Write};
use std::os::fd::{AsRawFd, FromRawFd};
use std::os::unix::net::{UnixListener, UnixStream};
use std::time::{Duration, Instant};

enum Failure {
    Usage(String),
    Stop(String),
}

fn main() {
    match run() {
        Ok(()) => {}
        Err(Failure::Usage(m)) => {
            eprintln!("wl-keyboard: {m}\nusage: wl-keyboard --control PATH --keymap FILE");
            std::process::exit(2);
        }
        Err(Failure::Stop(m)) => {
            eprintln!("wl-keyboard: {m}");
            std::process::exit(1);
        }
    }
}

struct Args {
    control: String,
    keymap: String,
}

fn parse_args() -> Result<Args, Failure> {
    let a: Vec<String> = std::env::args().skip(1).collect();
    let mut control = None;
    let mut keymap = None;
    let mut i = 0;
    while i + 1 < a.len() {
        match a[i].as_str() {
            "--control" => control = Some(a[i + 1].clone()),
            "--keymap" => keymap = Some(a[i + 1].clone()),
            other => return Err(Failure::Usage(format!("unknown argument {other}"))),
        }
        i += 2;
    }
    match (control, keymap) {
        (Some(control), Some(keymap)) => Ok(Args { control, keymap }),
        _ => Err(Failure::Usage("--control and --keymap are required".into())),
    }
}

// ---------- the few C functions this needs ----------
#[repr(C)]
struct IoVec {
    base: *const u8,
    len: usize,
}
#[repr(C)]
struct MsgHdr {
    name: *mut u8,
    namelen: u32,
    iov: *const IoVec,
    iovlen: usize,
    control: *mut u8,
    controllen: usize,
    flags: i32,
}
extern "C" {
    fn memfd_create(name: *const u8, flags: u32) -> i32;
    fn sendmsg(fd: i32, msg: *const MsgHdr, flags: i32) -> isize;
}

struct Wire {
    sock: UnixStream,
    next: u32,
    buf: Vec<u8>,
}

impl Wire {
    fn id(&mut self) -> u32 {
        self.next += 1;
        self.next
    }
    fn msg(obj: u32, op: u16, payload: &[u8]) -> Vec<u8> {
        let mut m = Vec::with_capacity(8 + payload.len());
        m.extend_from_slice(&obj.to_le_bytes());
        m.extend_from_slice(&((((8 + payload.len()) as u32) << 16) | op as u32).to_le_bytes());
        m.extend_from_slice(payload);
        m
    }
    fn send(&mut self, obj: u32, op: u16, payload: &[u8]) -> Result<(), Failure> {
        self.sock.write_all(&Wire::msg(obj, op, payload)).map_err(|e| Failure::Stop(format!("write: {e}")))
    }
    fn send_fd(&mut self, obj: u32, op: u16, payload: &[u8], fd: i32) -> Result<(), Failure> {
        let data = Wire::msg(obj, op, payload);
        let iov = IoVec { base: data.as_ptr(), len: data.len() };
        // cmsghdr { len: usize, level: i32, type: i32 } + one int, padded to 8.
        let mut cmsg = [0u8; 24];
        cmsg[0..8].copy_from_slice(&20usize.to_ne_bytes());
        cmsg[8..12].copy_from_slice(&1i32.to_ne_bytes()); // SOL_SOCKET
        cmsg[12..16].copy_from_slice(&1i32.to_ne_bytes()); // SCM_RIGHTS
        cmsg[16..20].copy_from_slice(&fd.to_ne_bytes());
        let hdr = MsgHdr { name: std::ptr::null_mut(), namelen: 0, iov: &iov, iovlen: 1, control: cmsg.as_mut_ptr(), controllen: cmsg.len(), flags: 0 };
        // SAFETY: hdr, iov, data and cmsg outlive the call; the socket fd is open.
        let n = unsafe { sendmsg(self.sock.as_raw_fd(), &hdr, 0) };
        if n != data.len() as isize {
            return Err(Failure::Stop("sendmsg failed".into()));
        }
        Ok(())
    }
    // Read events until the sync callback fires; hand each other event to f.
    fn roundtrip(&mut self, mut f: impl FnMut(u32, u16, &[u8])) -> Result<(), Failure> {
        let cb = self.id();
        self.send(1, 0, &cb.to_le_bytes())?;
        let mut chunk = [0u8; 4096];
        loop {
            while self.buf.len() >= 8 {
                let obj = u32::from_le_bytes(self.buf[0..4].try_into().unwrap());
                let word = u32::from_le_bytes(self.buf[4..8].try_into().unwrap());
                let size = (word >> 16) as usize;
                if self.buf.len() < size {
                    break;
                }
                let body: Vec<u8> = self.buf[8..size].to_vec();
                self.buf.drain(..size);
                if obj == 1 && (word & 0xffff) == 0 {
                    return Err(Failure::Stop("wayland protocol error".into()));
                }
                if obj == cb {
                    return Ok(());
                }
                f(obj, (word & 0xffff) as u16, &body);
            }
            let n = self.sock.read(&mut chunk).map_err(|e| Failure::Stop(format!("read: {e}")))?;
            if n == 0 {
                return Err(Failure::Stop("compositor closed the connection".into()));
            }
            self.buf.extend_from_slice(&chunk[..n]);
        }
    }
}

fn wl_string(s: &str) -> Vec<u8> {
    let mut v = Vec::new();
    v.extend_from_slice(&((s.len() + 1) as u32).to_le_bytes());
    v.extend_from_slice(s.as_bytes());
    v.push(0);
    while v.len() % 4 != 0 {
        v.push(0);
    }
    v
}

fn keycode(name: &str) -> Option<u32> {
    let letters = "qwertyuiop";
    let row2 = "asdfghjkl";
    let row3 = "zxcvbnm";
    if name.len() == 1 {
        let c = name.chars().next()?;
        if let Some(i) = letters.find(c) { return Some(16 + i as u32); }
        if let Some(i) = row2.find(c) { return Some(30 + i as u32); }
        if let Some(i) = row3.find(c) { return Some(44 + i as u32); }
        if c == '0' { return Some(11); }
        if c.is_ascii_digit() { return Some(1 + c.to_digit(10)?); }
        if c == ' ' { return Some(57); }
        return None;
    }
    Some(match name {
        "escape" => 1, "backspace" => 14, "tab" => 15, "enter" => 28, "space" => 57,
        "up" => 103, "left" => 105, "right" => 106, "down" => 108, "insert" => 110, "delete" => 111,
        _ => return None,
    })
}

struct Keyboard {
    wire: Wire,
    kb: u32,
    start: Instant,
}

impl Keyboard {
    fn stamp(&self) -> u32 {
        self.start.elapsed().as_millis() as u32
    }
    fn mods(&mut self, depressed: u32) -> Result<(), Failure> {
        let mut p = Vec::new();
        for v in [depressed, 0, 0, 0] { p.extend_from_slice(&v.to_le_bytes()); }
        self.wire.send(self.kb, 2, &p)
    }
    fn key(&mut self, code: u32, down: bool) -> Result<(), Failure> {
        let mut p = Vec::new();
        for v in [self.stamp(), code, down as u32] { p.extend_from_slice(&v.to_le_bytes()); }
        self.wire.send(self.kb, 1, &p)
    }
    fn tap(&mut self, mods: &[(u32, u32)], code: u32) -> Result<(), Failure> {
        let mut mask = 0;
        for &(mc, bit) in mods { self.key(mc, true)?; mask |= bit; self.mods(mask)?; }
        self.wire.roundtrip(|_, _, _| {})?;
        std::thread::sleep(Duration::from_millis(20));
        self.key(code, true)?;
        self.wire.roundtrip(|_, _, _| {})?;
        std::thread::sleep(Duration::from_millis(30));
        self.key(code, false)?;
        for &(mc, _) in mods.iter().rev() { self.key(mc, false)?; }
        self.mods(0)?;
        self.wire.roundtrip(|_, _, _| {})?;
        std::thread::sleep(Duration::from_millis(20));
        Ok(())
    }
    fn command(&mut self, line: &str) -> Result<(), String> {
        let (verb, rest) = line.split_once(' ').unwrap_or((line, ""));
        let fail = |e: Failure| match e { Failure::Usage(m) | Failure::Stop(m) => m };
        match verb {
            "key" => {
                let code = keycode(rest).ok_or(format!("unknown key {rest}"))?;
                self.tap(&[], code).map_err(fail)
            }
            "chord" => {
                let parts: Vec<&str> = rest.split('+').collect();
                let (name, mods) = parts.split_last().ok_or("empty chord")?;
                let mut m = Vec::new();
                for p in mods {
                    m.push(match *p { "ctrl" => (29, 4), "alt" => (56, 8), "shift" => (42, 1), other => return Err(format!("unknown modifier {other}")) });
                }
                let code = keycode(name).ok_or(format!("unknown key {name}"))?;
                self.tap(&m, code).map_err(fail)
            }
            "type" => {
                for c in rest.chars() {
                    let code = keycode(&c.to_string()).ok_or(format!("cannot type {c}"))?;
                    self.tap(&[], code).map_err(fail)?;
                }
                Ok(())
            }
            other => Err(format!("unknown command {other}")),
        }
    }
}

fn run() -> Result<(), Failure> {
    let args = parse_args()?;
    let keymap = std::fs::read(&args.keymap).map_err(|e| Failure::Stop(format!("{}: {e}", args.keymap)))?;
    let runtime = std::env::var("XDG_RUNTIME_DIR").map_err(|_| Failure::Stop("XDG_RUNTIME_DIR is not set".into()))?;
    let display = std::env::var("WAYLAND_DISPLAY").unwrap_or_else(|_| "wayland-0".into());
    let sock = UnixStream::connect(format!("{runtime}/{display}")).map_err(|e| Failure::Stop(format!("connect: {e}")))?;
    let mut wire = Wire { sock, next: 1, buf: Vec::new() };

    let registry = wire.id();
    wire.send(1, 1, &registry.to_le_bytes())?;
    let mut globals: HashMap<String, (u32, u32)> = HashMap::new();
    wire.roundtrip(|obj, op, body| {
        if obj != registry || op != 0 { return; }
        let name = u32::from_le_bytes(body[0..4].try_into().unwrap());
        let len = u32::from_le_bytes(body[4..8].try_into().unwrap()) as usize;
        let iface = String::from_utf8_lossy(&body[8..8 + len - 1]).to_string();
        let off = 8 + ((len + 3) & !3);
        let version = u32::from_le_bytes(body[off..off + 4].try_into().unwrap());
        globals.insert(iface, (name, version));
    })?;
    let bind = |wire: &mut Wire, iface: &str| -> Result<u32, Failure> {
        let (name, _) = *globals.get(iface).ok_or(Failure::Stop(format!("the compositor has no {iface}")))?;
        let id = wire.id();
        let mut p = name.to_le_bytes().to_vec();
        p.extend(wl_string(iface));
        p.extend_from_slice(&1u32.to_le_bytes());
        p.extend_from_slice(&id.to_le_bytes());
        wire.send(registry, 0, &p)?;
        Ok(id)
    };
    let seat = bind(&mut wire, "wl_seat")?;
    let manager = bind(&mut wire, "zwp_virtual_keyboard_manager_v1")?;
    let kb = wire.id();
    let mut p = seat.to_le_bytes().to_vec();
    p.extend_from_slice(&kb.to_le_bytes());
    wire.send(manager, 0, &p)?;

    // SAFETY: a fresh memfd that this File owns from here on.
    let fd = unsafe { memfd_create(b"pyxamp-keymap\0".as_ptr(), 0) };
    if fd < 0 { return Err(Failure::Stop("memfd_create failed".into())); }
    let mut file = unsafe { std::fs::File::from_raw_fd(fd) };
    file.write_all(&keymap).map_err(|e| Failure::Stop(format!("keymap: {e}")))?;
    file.write_all(&[0]).map_err(|e| Failure::Stop(format!("keymap: {e}")))?;
    let mut p = 1u32.to_le_bytes().to_vec(); // WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1
    p.extend_from_slice(&((keymap.len() + 1) as u32).to_le_bytes());
    wire.send_fd(kb, 0, &p, file.as_raw_fd())?;
    wire.roundtrip(|_, _, _| {})?;

    let mut keyboard = Keyboard { wire, kb, start: Instant::now() };
    let _ = std::fs::remove_file(&args.control);
    let listener = UnixListener::bind(&args.control).map_err(|e| Failure::Stop(format!("{}: {e}", args.control)))?;
    eprintln!("wl-keyboard: ready");
    for conn in listener.incoming() {
        let Ok(conn) = conn else { continue };
        let mut out = conn.try_clone().map_err(|e| Failure::Stop(e.to_string()))?;
        for line in BufReader::new(conn).lines() {
            let Ok(line) = line else { break };
            let reply = match keyboard.command(line.trim()) { Ok(()) => "ok".to_string(), Err(e) => format!("error: {e}") };
            let _ = writeln!(out, "{reply}");
        }
    }
    Ok(())
}
