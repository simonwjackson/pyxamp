#!/usr/bin/env -S nix develop --command bash
# The real daemon and pyxampctl against the local Jellyfin test instance:
# library, paging, search and a video hand-off through the socket and the
# session, on a private D-Bus session and a private XDG_RUNTIME_DIR.
#
# Run from the repository root after daemon/tools/jellyfin-test-server is up
# (JELLYFIN_TEST_DIR, default /tmp/pyxamp-jellyfin-test). Never the live server.
set -euo pipefail
export CARGO_BUILD_JOBS=2
dir=${JELLYFIN_TEST_DIR:-/tmp/pyxamp-jellyfin-test}

if [[ ${1:-} != --inside ]]; then
  [[ -f $dir/env ]] || { echo "start daemon/tools/jellyfin-test-server $dir first" >&2; exit 1; }
  mapfile -t paths < <(flock /tmp/pyxamp-wf8145-build.lock nix build --no-link --print-out-paths \
    --max-jobs 1 --cores 2 --inputs-from . nixpkgs#mpv nixpkgs#mpvScripts.mpris)
  flock /tmp/pyxamp-wf8145-build.lock cargo build -p pyxamp-daemon --bin pyxamp-daemon --bin pyxampctl
  export SMOKE_MPV=${paths[0]} PYXAMP_MPV_MPRIS=${paths[1]}/share/mpv/scripts/mpris.so
  exec dbus-run-session -- "$0" --inside
fi

set -a
# shellcheck disable=SC1091
source "$dir/env"
set +a
work=$(mktemp -d)
mkdir -m 700 "$work/run" "$work/bin"
trap 'status=$?; set +e; kill $daemon 2>/dev/null; wait $daemon 2>/dev/null; rm -rf "$work"; exit $status' EXIT
printf '#!/bin/sh\nexec %s/bin/mpv --vo=null --ao=null "$@"\n' "$SMOKE_MPV" >"$work/bin/mpv"
chmod +x "$work/bin/mpv"
cat >"$work/sources.toml" <<EOF
[jellyfin]
url = "$JELLYFIN_TEST_URL"
api_key_file = "$JELLYFIN_TEST_KEY_FILE"
user = "$JELLYFIN_TEST_USER"
EOF
export XDG_RUNTIME_DIR=$work/run PYXAMP_SOURCES=$work/sources.toml PATH="$work/bin:$PATH"
RUST_LOG=pyxamp_daemon=info target/debug/pyxamp-daemon 2>"$work/daemon.log" &
daemon=$!
ctl() { target/debug/pyxampctl "$@"; }
for _ in $(seq 100); do
  ctl state 2>/dev/null | jq -e '.payload.library.sources[0].status._tag == "ready"' >/dev/null && break
  sleep 0.2
done
echo "== library"
ctl state | jq -c '.payload.library'
echo "== library.open albums"
ctl request '{"id":"a","action":{"_tag":"library.open","payload":{"source":"jellyfin","node":"albums"}}}' |
  jq -c 'if .payload.items then {items: [.payload.items[] | {id, title, subtitle, year, count}], total: .payload.total} else .payload end'
album=$(ctl request '{"id":"a","action":{"_tag":"library.open","payload":{"source":"jellyfin","node":"albums"}}}' |
  jq -r 'select(.payload.items) | .payload.items[] | select(.title == "Sines") | .id')
echo "== library.open $album, cursor 1"
ctl request "{\"id\":\"t\",\"action\":{\"_tag\":\"library.open\",\"payload\":{\"source\":\"jellyfin\",\"node\":\"$album\",\"cursor\":\"1\"}}}" |
  jq -c 'if .payload.items then {titles: [.payload.items[].title], total: .payload.total} else .payload end'
echo "== search tones"
ctl request '{"id":"s","action":{"_tag":"search","payload":{"query":"tones"}}}' |
  jq -c 'if .payload.items then [.payload.items[] | {source, kind, title}] else .payload end'
echo "== video hand-off"
video=$(ctl request '{"id":"s","action":{"_tag":"search","payload":{"query":"pattern"}}}' |
  jq -r 'select(.payload.items) | .payload.items[0].id')
ctl request "{\"id\":\"v\",\"action\":{\"_tag\":\"item.play\",\"payload\":{\"source\":\"jellyfin\",\"item\":\"$video\",\"mode\":\"now\"}}}"
for _ in $(seq 50); do
  ctl state | jq -e '.payload.player._tag == "following"' >/dev/null && break
  sleep 0.2
done
echo "== followed player"
ctl state | jq -c '.payload.player | if .payload.identity then {tag: ._tag, identity: .payload.identity, title: .payload.track.title, transport: .payload.transport, bus: .payload.target.busName} else . end'
grep -qF "$(cat "$JELLYFIN_TEST_KEY_FILE")" "$work/daemon.log" && { echo "the API key is in the daemon log" >&2; exit 1; }
echo "== no API key in the daemon log"
