#!/usr/bin/env -S nix develop --command bash
# Runs the Ossicle connector's service tests against a locally run Ossicle.
# Run from the repository root. Never touches a live Ossicle: each test starts
# its own ossicle-server on 127.0.0.1 with a scratch cache, a local feed and
# books fixture, generated WAV audio and daemon/tools/ossicle-fake-ytdlp.
#
#   OSSICLE_SERVER_BIN=/path/to/ossicle-server daemon/tools/ossicle-test
#
# Without OSSICLE_SERVER_BIN it builds `ossicle-server` from $OSSICLE_REPO
# (default ~/code/sandbox/ossicle, branch main) with bounded Nix jobs.
set -euo pipefail
export CARGO_BUILD_JOBS=2
lock=/tmp/pyxamp-wf8145-build.lock
if [[ -z ${OSSICLE_SERVER_BIN:-} ]]; then
  repo=${OSSICLE_REPO:-$HOME/code/sandbox/ossicle}
  out=$(flock "$lock" nix build "git+file://$repo?ref=main#ossicle-server" \
    --max-jobs 1 --cores 2 --no-link --print-out-paths | head -1)
  export OSSICLE_SERVER_BIN="$out/bin/ossicle-server"
fi
test -x "$OSSICLE_SERVER_BIN" || { echo "ossicle-test: $OSSICLE_SERVER_BIN is not executable" >&2; exit 1; }
export OSSICLE_FAKE_YTDLP="$PWD/daemon/tools/ossicle-fake-ytdlp"
flock "$lock" cargo test -p pyxamp-daemon --test ossicle_service -- --ignored --test-threads=1 "$@"
