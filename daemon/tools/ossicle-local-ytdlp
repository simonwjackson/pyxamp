#!/bin/sh
# Test-only yt-dlp for daemon/tests/ossicle_service.rs. A local Ossicle runs
# with YTDLP_BIN pointing here, so a YouTube-shaped episode "downloads" the
# generated clip in $OSSICLE_LOCAL_YTDLP_CLIP instead of touching YouTube.
# It writes the -o target and prints the metadata JSON that yt-dlp prints.
set -eu
target=
previous=
for argument in "$@"; do
  if [ "$previous" = "-o" ]; then target="$argument"; fi
  previous="$argument"
done
[ -n "$target" ] || { echo "ossicle-local-ytdlp: no -o target" >&2; exit 2; }
cp "$OSSICLE_LOCAL_YTDLP_CLIP" "$target"
printf '{"duration": %s}\n' "${OSSICLE_LOCAL_YTDLP_DURATION:-120}"
